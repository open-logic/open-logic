CAPI=2:

name : "open-logic:open-logic:ft:4.7.0"
description : "stable release (downloaded from GitHub); Fault tolerant circuitry (e.g. SECDED protected RAMs, scrubbers, ...) see https://github.com/open-logic/open-logic/blob/main/doc/EntityList.md#ft"

filesets:
  rtl:
    files:
      - "src/ft/vhdl/olo_ft_ecc_decode.vhd"
      - "src/ft/vhdl/olo_ft_ecc_encode.vhd"
      - "src/ft/vhdl/olo_ft_fifo_packet.vhd"
      - "src/ft/vhdl/olo_ft_fifo_sync.vhd"
      - "src/ft/vhdl/olo_ft_pkg_ecc.vhd"
      - "src/ft/vhdl/olo_ft_private_scrubber.vhd"
      - "src/ft/vhdl/olo_ft_ram_sdp.vhd"
      - "src/ft/vhdl/olo_ft_ram_sdp_scrub.vhd"
      - "src/ft/vhdl/olo_ft_ram_sp.vhd"
      - "src/ft/vhdl/olo_ft_ram_sp_scrub.vhd"
      - "src/ft/vhdl/olo_ft_ram_tdp.vhd"
    file_type : "vhdlSource-2008"
    logical_name : "olo"
    depend :
      - "^open-logic:open-logic:base:4.7.0"


targets:
  default:
    filesets :
      - "rtl"
provider:
  name    : github
  user    : open-logic
  repo    : open-logic
  version : 4.7.0
  