---------------------------------------------------------------------------------------------------
-- Description
---------------------------------------------------------------------------------------------------
-- Tables for linear function approximations (see olo_fix_lin_approx_calc). The package contains one
-- table per approximation, so an entity can select between them at elaboration time.
--
-- DO NOT EDIT MANUALLY - this file is generated by the Python model olo_fix_lin_approx. The table
-- content is generated in Python (and not calculated in VHDL) because the accuracy of
-- ieee.math_real is implementation defined and would therefore differ between tools.
--
-- Documentation:
-- https://github.com/open-logic/open-logic/blob/main/doc/fix/olo_fix_lin_approx.md

---------------------------------------------------------------------------------------------------
-- Libraries
---------------------------------------------------------------------------------------------------
library ieee;
    use ieee.std_logic_1164.all;
    use ieee.numeric_std.all;

library work;
    use work.olo_base_pkg_array.all;
    use work.en_cl_fix_pkg.all;

---------------------------------------------------------------------------------------------------
-- Package Header
---------------------------------------------------------------------------------------------------
package {{package_name}} is

    -- Width one table entry is padded to. The entries of all tables share the same width so they
    -- can be stored in one array type. The padding is meant to be sliced away by the entity, hence
    -- it does not cost any memory.
    constant LinApproxEntryWidth_c : positive := {{entry_width}};

    -- Types
    subtype LinApproxEntry_t is std_logic_vector(LinApproxEntryWidth_c - 1 downto 0);
    type LinApproxTable_t is array (natural range <>) of LinApproxEntry_t;

    -- Table content of the approximation with the given name. Each entry contains the gradient
    -- (MSBs) and the offset (LSBs), zero padded to LinApproxEntryWidth_c.
    function getTable (Name : string) return LinApproxTable_t;

    -- Number of points (segments) of the table of the approximation with the given name
    function getTableSize (Name : string) return positive;

    -- Number formats the table entries of the approximation with the given name are coded in
    function getOffsetFmt (Name : string) return string;
    function getGradientFmt (Name : string) return string;

end package;

---------------------------------------------------------------------------------------------------
-- Package Body
---------------------------------------------------------------------------------------------------
package body {{package_name}} is

    -- *** Table Formats ***
    constant Tables_c : positive := {{tables|length}};

    constant OffsFmts_c : FixFormatArray_t(0 to Tables_c - 1) := (
{% for t in tables %}
        {{ t.offs_fmt }}{{ "," if not loop.last }}
{% endfor %}
    );

    constant GradFmts_c : FixFormatArray_t(0 to Tables_c - 1) := (
{% for t in tables %}
        {{ t.grad_fmt }}{{ "," if not loop.last }}
{% endfor %}
    );

    constant Points_c : IntegerArray_t(0 to Tables_c - 1) := (
{% for t in tables %}
        {{ t.points }}{{ "," if not loop.last }}
{% endfor %}
    );

    -- *** Tables ***
    -- Aligning the table entries as suggested by the linter is not sensible for large tables
    -- vsg_off constant_400
{% for t in tables %}

    -- "{{t.name}}": {{t.points}} points, {{t.width}} bit per entry
    constant Table{{t.index}}_c : LinApproxTable_t(0 to {{t.points - 1}}) := (
{% for row in t.rows %}
        x"{{row}}"{{ "," if not loop.last }}
{% endfor %}
    );
{% endfor %}
    -- vsg_on constant_400

    -- *** Name Lookup ***
    function tableIndex (Name : string) return natural is
    begin

{% for t in tables %}
        if Name = "{{t.name}}" then
            return {{t.index}};
        end if;

{% endfor %}
        report "{{package_name}}: no table named '" & Name & "'. Available tables: " &
{% for line in available %}
               "{{line}}"{{ " &" if not loop.last }}
{% endfor %}
            severity failure;
        return 0;
    end function;

    -- *** Public Functions ***
    function getTable (Name : string) return LinApproxTable_t is
    begin

        case tableIndex(Name) is
{% for t in tables %}
            when {{t.index}} => return Table{{t.index}}_c;
{% endfor %}
            when others => return Table0_c;
        end case;

    end function;

    function getTableSize (Name : string) return positive is
    begin
        return Points_c(tableIndex(Name));
    end function;

    function getOffsetFmt (Name : string) return string is
    begin
        return to_string(OffsFmts_c(tableIndex(Name)));
    end function;

    function getGradientFmt (Name : string) return string is
    begin
        return to_string(GradFmts_c(tableIndex(Name)));
    end function;

end package body;
