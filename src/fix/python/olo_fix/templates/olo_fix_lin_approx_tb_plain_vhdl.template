-- Bit-true testbench for {{entity_name}} - generated by olo_fix_lin_approx (Open Logic).
--
-- Plain VHDL testbench (no VUnit required). Mismatches are reported with severity error, the
-- simulation stops by itself (clock stopped) once all samples are checked.
--
-- DO NOT EDIT MANUALLY - regenerate the file from the Python configuration instead.
---------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------
-- Libraries
---------------------------------------------------------------------------------------------------
library ieee;
    use ieee.std_logic_1164.all;
    use ieee.numeric_std.all;
    use ieee.math_real.all;

library {{olo_library}};
    use {{olo_library}}.en_cl_fix_pkg.all;
    use {{olo_library}}.olo_fix_pkg.all;

---------------------------------------------------------------------------------------------------
-- Entity
---------------------------------------------------------------------------------------------------
entity {{entity_name}}_tb is
    generic (
        DataDir_g : string := "{{data_dir}}"
    );
end entity;

architecture sim of {{entity_name}}_tb is

    -----------------------------------------------------------------------------------------------
    -- TB Definitions
    -----------------------------------------------------------------------------------------------
    constant Clk_Frequency_c : real := 100.0e6; -- 100 MHz
    constant Clk_Period_c    : time := (1 sec) / Clk_Frequency_c;

    -- Number Formats
    constant InFmt_c  : string := "{{in_fmt}}";
    constant OutFmt_c : string := "{{out_fmt}}";

    -- Number of samples to check and maximum time to wait for them
    constant Samples_c : positive := {{samples}};
    constant Timeout_c : time     := Clk_Period_c * (Samples_c + 1000);

    -- Files
    constant InFile_c  : string := DataDir_g & "{{in_file}}";
    constant OutFile_c : string := DataDir_g & "{{out_file}}";

    signal TbRunning : boolean := true;
    signal Done      : boolean := false;

    -----------------------------------------------------------------------------------------------
    -- Interface Signals
    -----------------------------------------------------------------------------------------------
    signal Clk        : std_logic := '0';
    signal Rst        : std_logic := '1';
    signal In_Valid   : std_logic;
    signal In_Data    : std_logic_vector(fixFmtWidthFromString(InFmt_c) - 1 downto 0);
    signal Out_Valid  : std_logic;
    signal Out_Result : std_logic_vector(fixFmtWidthFromString(OutFmt_c) - 1 downto 0);

begin

    -----------------------------------------------------------------------------------------------
    -- TB Control
    -----------------------------------------------------------------------------------------------
    p_control : process is
    begin
        -- Reset
        wait until rising_edge(Clk);
        Rst <= '1';
        wait for 1 us;
        wait until rising_edge(Clk);
        Rst <= '0';

        -- Wait until all samples are checked
        wait until Done for Timeout_c;
        assert Done
            report "{{entity_name}}_tb: Timeout - not all samples were received"
            severity error;
        wait for 1 us;

        -- TB done (stopping the clock ends the simulation)
        report "{{entity_name}}_tb: Simulation done";
        TbRunning <= false;
        wait;
    end process;

    -- Count output samples
    p_count : process (Clk) is
        variable Count_v : natural := 0;
    begin
        if rising_edge(Clk) then
            if Out_Valid = '1' then
                Count_v := Count_v + 1;
            end if;
            if Count_v >= Samples_c then
                Done <= true;
            end if;
        end if;
    end process;

    -----------------------------------------------------------------------------------------------
    -- Clock
    -----------------------------------------------------------------------------------------------
    Clk <= not Clk after 0.5*Clk_Period_c when TbRunning else '0';

    -----------------------------------------------------------------------------------------------
    -- DUT
    -----------------------------------------------------------------------------------------------
    i_dut : entity work.{{entity_name}}
        port map (
            Clk        => Clk,
            Rst        => Rst,
            In_Valid   => In_Valid,
            In_Data    => In_Data,
            Out_Valid  => Out_Valid,
            Out_Result => Out_Result
        );

    -----------------------------------------------------------------------------------------------
    -- Stimuli and Checker
    -----------------------------------------------------------------------------------------------
    i_stimuli : entity {{olo_library}}.olo_fix_sim_stimuli
        generic map (
            FilePath_g => InFile_c,
            Fmt_g      => InFmt_c
        )
        port map (
            Clk   => Clk,
            Rst   => Rst,
            Valid => In_Valid,
            Data  => In_Data
        );

    i_checker : entity {{olo_library}}.olo_fix_sim_checker
        generic map (
            FilePath_g => OutFile_c,
            Fmt_g      => OutFmt_c
        )
        port map (
            Clk   => Clk,
            Valid => Out_Valid,
            Data  => Out_Result
        );

end architecture;
